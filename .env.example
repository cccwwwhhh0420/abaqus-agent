# ==========================================
# LLM API Configuration
# ==========================================
# Supports any OpenAI-compatible provider (OpenAI, DeepSeek, Qwen, vLLM, Ollama, etc.)
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=your_model_name

# Optional alternative API key variable names:
# DEEPSEEK_API_KEY=your_api_key_here
# QWEN_API_KEY=your_api_key_here
# API_KEY=your_api_key_here

# ==========================================
# Abaqus Communication & Execution
# ==========================================
ABAQUS_BRIDGE_HOST=127.0.0.1
ABAQUS_BRIDGE_PORT=23457
ABAQUS_TIMEOUT=30.0

# Optional terminal confirmation before publication; false enables continuous execution.
CONFIRM_BEFORE_EXEC=false

# ==========================================
# Project & Workspace Paths
# ==========================================
# Explicit project root path override (defaults to repository directory)
# PROJECT_ROOT=C:/path/to/abaqus-agent

# Workspace directory for model files (.cae, .inp, .odb, abaqus.rpy)
WORKSPACE_DIR=./workspace

# Optional custom IPC directory override (defaults to <WORKSPACE_DIR>/.ipc)
# ABAQUS_IPC_DIR=./workspace/.ipc

# ==========================================
# Abaqus Auto-Launch Configuration
# ==========================================
# System command name or absolute path to abaqus.bat
ABAQUS_COMMAND=abaqus
AUTO_LAUNCH_ABAQUS=true

# ==========================================
# Agent Execution Settings
# ==========================================
# Maximum autonomous reasoning and tool-call steps per turn
MAX_AGENT_STEPS=15
